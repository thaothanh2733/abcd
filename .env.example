PORT=3000
# Lấy API Key Google Gemini miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Chi key bí mật chỉ dùng ở backend; không thêm tiền tố NEXT_PUBLIC/VITE hoặc nhúng vào frontend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
