#!/usr/bin/env sh
# Gradle Wrapper Script (gradlew) - generated for LaChanNguoiThan Android project

##############################################################################
# Determine the Java command to use to start the JVM.
##############################################################################
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

# Increase the maximum file descriptors if we can.
MAX_FD="maximum"
warn () {
    echo "$*"
}
die () {
    echo "$*"
    exit 1
}

case $( uname ) in
    Linux*)
        MAX_FD_LIMIT=$(ulimit -H -n) || warn "Could not query maximum file descriptor limit"
        case $MAX_FD_LIMIT in
            '' | soft) MAX_FD="$MAX_FD_LIMIT";;
            *) MAX_FD="$MAX_FD_LIMIT";;
        esac
        ulimit -n $MAX_FD || warn "Could not set maximum file descriptors to $MAX_FD";;
esac

APP_HOME=$(cd "$(dirname "$0")" && pwd)
APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

exec "$JAVACMD" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
